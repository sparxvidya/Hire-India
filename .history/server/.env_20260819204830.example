# Nothing is required to run this app in dev — sensible defaults are
# used below. For a real deployment, set your own ADMIN_PASSWORD.

# Port the Express server listens on
PORT=5000

# Admin panel password (checked server-side — never shipped to the
# browser). Defaults to "xsparx@2024" if unset, which is fine for
# local testing but change it before deploying anywhere public.
ADMIN_PASSWORD=vidy

# Optional: if you later swap the local career advisor for a real LLM
# (see README "Upgrading to a real LLM"), put that provider's key here.
